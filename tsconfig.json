{
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "node16",
    "module": "node16",
    "target": "es2019",
    "lib": ["ESNext"],
    "declaration": true,
    "sourceMap": true,
    "removeComments": false,
    "alwaysStrict": true,
    "pretty": true,
    "outDir": "dist",
    "incremental": true,
    "noEmitHelpers": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strictPropertyInitialization": true
  },
  "include": [
    "src",
    "enums",
    "resources",
    "index.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "docs"
  ]
}
